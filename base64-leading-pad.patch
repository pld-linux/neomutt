From c8a2e5a7d07234a630f63617da3951dd707a5259 Mon Sep 17 00:00:00 2001
From: Yvonne <yvonnelxxxx@gmail.com>
Date: Mon, 10 Aug 2026 12:30:07 +0800
Subject: [PATCH 08/10] fix decode_base64 issue when leading is =

(cherry picked from commit eb4f57801f4d275e349ba3b5fc6a27d6cc95deec)
---
 handler.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/handler.c b/handler.c
index 5e1e6eb..7d27355 100644
--- a/handler.c
+++ b/handler.c
@@ -1562,7 +1562,11 @@ void mutt_decode_base64(struct State *state, size_t len, bool istext, iconv_t cd
     }
 
     const int c1 = base64val(buf[0]);
+    if (c1 == -1) /* '=' (or any non-base64 char) at slot 0: stop */
+      break;
     const int c2 = base64val(buf[1]);
+    if (c2 == -1) /* '=' at slot 1: invalid padding, stop */
+      break;
 
     /* first char */
     ch = (c1 << 2) | (c2 >> 4);
